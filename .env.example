# ─────────────────────────────────────────────────────────────────
# DSH Deployment Environment Configuration (example)
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# DeepSeek API key for model access.
# The web UI also lets you configure models at runtime via Settings > Models.
DEEPSEEK_API_KEY=

# The public URL that browsers use to reach the deployment.
# This is what dsh advertises in its startup output and UI.
# Change the IP/port to match your nginx external address.
DSH_PUBLIC_URL=http://192.168.76.12/

# The browser-visible authority that dsh's host fence should trust.
# Without this, dsh returns 403 for every API call from the browser.
# An entry without a port matches any port.
DSH_TRUSTED_HOST=192.168.76.12
