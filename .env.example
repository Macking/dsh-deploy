# ─────────────────────────────────────────────────────────────────
# DSH Deployment Environment Configuration (example)
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# DeepSeek API key for model access.
# The web UI also lets you configure models at runtime via Settings > Models.
DEEPSEEK_API_KEY=

# The public URL that browsers use to reach the deployment.
# Leave as http://localhost/ to auto-detect the server's LAN IP at container
# startup (recommended -- works on any machine without editing this file).
# To pin a specific URL, set it here (e.g., http://192.168.76.248/ or
# https://dsh.example.com/). The deploy scripts also set this automatically.
DSH_PUBLIC_URL=http://localhost/

# The browser-visible authority that dsh's host fence should trust.
# Leave as localhost to auto-detect the server's LAN IP at container startup.
# Set explicitly to match DSH_PUBLIC_URL when pinning a specific host.
DSH_TRUSTED_HOST=localhost
